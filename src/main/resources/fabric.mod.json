{
  "schemaVersion": 1,
  "id": "visual-swap",
  "version": "${version}",
  "name": "Visual Swap",
  "description": "Client-side visualizer for Minecraft's attribute-swapping behavior.",
  "authors": [
    "patchnote-mc"
  ],
  "contact": {
    "homepage": "https://github.com/patchnote-mc/VisualSwap",
    "sources": "https://github.com/patchnote-mc/VisualSwap",
    "issues": "https://github.com/patchnote-mc/VisualSwap/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/visual-swap/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.patchnote.visualswap.client.VisualSwapClient"
    ],
    "modmenu": [
      "com.patchnote.visualswap.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "visual-swap.mixins.json",
    {
      "config": "visual-swap.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": ">=26.2.155"
  },
  "suggests": {
    "modmenu": "*"
  }
}
