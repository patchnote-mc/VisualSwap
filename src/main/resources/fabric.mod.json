{
  "schemaVersion": 1,
  "id": "visual-swap",
  "version": "${version}",
  "name": "Visual Swap",
  "description": "Visualizes attribute swapping for better PVP",
  "authors": [
    "patchnote-mc"
  ],
  "contact": {},
  "license": "All Rights Reserved",
  "icon": "assets/visual-swap/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.patchnote.visualswap.client.VisualSwapClient"
    ],
    "modmenu": [
      "com.patchnote.visualswap.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "visual-swap.mixins.json",
    {
      "config": "visual-swap.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "cloth-config": ">=${cloth_config_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
